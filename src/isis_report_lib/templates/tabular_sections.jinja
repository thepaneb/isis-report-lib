{% macro render_section_content(label, span, style="", mark="") %}
    <section class="content">
        <label>{{label}}{% if mark %}<sup>{{mark}}</sup>{% endif %}</label>
        <span{% if style %} style="{{style}}"{% endif %}>{{span}}</span>
    </section>
{% endmacro %}
{% macro render_section(section_class, rows, layout, zip, fmt, cellstyle) %}
    <section class="{{section_class}}">
        {% for data, field in zip(rows.items(), layout) %}
            {{render_section_content(field.label, fmt(rows[field.name], field.format_mask, field=field), cellstyle(rows[field.name], field), mark=field.get('footnote_mark', ''))}}
        {% endfor %}
    </section>
{% endmacro %}
{% macro render_group_header(rows, layout, zip, fmt, level, cellstyle) %}
    {{render_section("group-header-%i" % level, rows, layout, zip, fmt, cellstyle)}}
{% endmacro %}
{% macro render_group_footer(rows, layout, zip, fmt, level, cellstyle) %}
    {{render_section("group-footer-%i" % level, rows, layout, zip, fmt, cellstyle)}}
{% endmacro %}
{% macro render_detail(rows, footer, layout, zip, fmt, cellstyle, empty_text="") %}
    {% if not rows and not footer and empty_text %}
    <p class="empty-table">{{empty_text}}</p>
    {% else %}
    <table class="report">
        <thead>
            <tr>
                {% for field in layout %}
                    <th style="text-align: {{field.alignment}}">{{field.label}}{% if field.footnote_mark %}<sup>{{field.footnote_mark}}</sup>{% endif %}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    {% for field in layout %}
                        <td style="text-align: {{field.alignment}};{{cellstyle(row[field.name], field)}}"><p>{{fmt(row[field.name], field.format_mask, field=field)}}</p></td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
        {% if footer %}
        <tfoot>
            <tr>
                {% for field in layout %}
                    <td style="text-align: {{field.alignment}};{{cellstyle(footer.get(field.name), field)}}"><p>{{fmt(footer.get(field.name), field.format_mask, field=field)}}</p></td>
                {% endfor %}
            </tr>
        </tfoot>
        {% endif %}
    </table>
    {% endif %}
{% endmacro %}
{% macro render_details(details, layouts, zip, fmt, cellstyle) %}
    {% for key, table in details.items() %}
        {% if key in layouts %}
            {{render_detail(table.rows, table.footer, layouts[key], zip, fmt, cellstyle, table.get('empty_text', ''))}}
        {% endif %}
    {% endfor %}
{% endmacro %}
{% macro render_group(rows, layout, zip, fmt, level, cellstyle) %}
    {% for row in rows %}
        {% if row.fields and layout.header %}
            {{render_group_header(row.fields, layout.header, zip, fmt, level, cellstyle)}}
        {% endif %}
        {% if row.groups and layout.groups %}
            {{render_group(row.groups, layout.groups, zip, fmt, level + 1, cellstyle)}}
        {% endif %}
        {% if row.details and layout.details %}
            {{render_details(row.details, layout.details, zip, fmt, cellstyle)}}
        {% endif %}
        {% if row.footer and layout.footer %}
            {{render_group_footer(row.footer, layout.footer, zip, fmt, level, cellstyle)}}
        {% endif %}
        {% if not loop.last and level == 0 %}
            {{render_divider()}}
        {% endif %}
    {% endfor %}
{% endmacro %}
{% macro render_divider() %}
    <hr class="divider-table"/>
{% endmacro %}
{% macro render_text(paragraphs) %}
    {% for paragraph in paragraphs %}
        <p>{{paragraph}}</p>
    {% endfor %}
{% endmacro %}
{% macro render_kpi(items, fmt) %}
    <section class="summary">
        {% for item in items %}
            {{render_section_content(item['label'], fmt(item.get('value'), item.get('format_mask', 'str'), field=item), mark=item.get('footnote_mark', ''))}}
        {% endfor %}
    </section>
{% endmacro %}
{% macro render_summary(rows, layout, zip, fmt, cellstyle) %}
    <section class="summary">
        {% for field in layout %}
            {{render_section_content(field.label, fmt(rows[field.name], field.format_mask, field=field), cellstyle(rows[field.name], field), mark=field.get('footnote_mark', ''))}}
        {% endfor %}
    </section>
{% endmacro %}
{% macro render_crosstab(ct, zip, fmt, cellstyle) %}    {% if ct.has_data %}
    <table class="report">
        <thead>
            <tr>
                <th style="text-align: left">{{ct.row_label}}{% if ct.row_field.footnote_mark %}<sup>{{ct.row_field.footnote_mark}}</sup>{% endif %}</th>
                {% for header in ct.col_headers %}
                    <th style="text-align: right">{{fmt(header, ct.col_field.get('format_mask', 'str'), field=ct.col_field)}}{% if ct.col_field.footnote_mark %}<sup>{{ct.col_field.footnote_mark}}</sup>{% endif %}</th>
                {% endfor %}
                {% if ct.totals %}
                    <th style="text-align: right">{{ct.total_label}}{% if ct.measure_field.footnote_mark %}<sup>{{ct.measure_field.footnote_mark}}</sup>{% endif %}</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
            {% for row_header, cells, total in zip(ct.row_headers, ct.cells, ct.row_totals) %}
                <tr>
                    <td style="text-align: left"><p>{{fmt(row_header, ct.row_field.get('format_mask', 'str'), field=ct.row_field)}}</p></td>
                    {% for cell in cells %}
                        <td style="text-align: right;{{cellstyle(cell, ct.measure_field)}}"><p>{{fmt(cell, ct.mask, field=ct.measure_field)}}</p></td>
                    {% endfor %}
                    {% if ct.totals %}
                        <td style="text-align: right;{{cellstyle(total, ct.measure_field)}}"><p>{{fmt(total, ct.mask, field=ct.measure_field)}}</p></td>
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
        {% if ct.totals %}
        <tfoot>
            <tr>
                <td style="text-align: left"><p>{{ct.total_label}}</p></td>
                {% for total in ct.col_totals %}
                    <td style="text-align: right;{{cellstyle(total, ct.measure_field)}}"><p>{{fmt(total, ct.mask, field=ct.measure_field)}}</p></td>
                {% endfor %}
                <td style="text-align: right;{{cellstyle(ct.grand_total, ct.measure_field)}}"><p>{{fmt(ct.grand_total, ct.mask, field=ct.measure_field)}}</p></td>
            </tr>
        </tfoot>
        {% endif %}
    </table>
    {% elif ct.empty_text %}
    <p class="empty-table">{{ct.empty_text}}</p>
    {% endif %}
{% endmacro %}
{% macro render_image(src, alt, width, align, caption) %}
    <figure class="report-image" style="text-align: {{ align }};">
        <img src="{{ src }}" alt="{{ alt }}"{% if width %} width="{{ width }}"{% endif %}/>
        {% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}
    </figure>
{% endmacro %}
{% macro render_toc(items) %}
    {% if items %}
    <nav class="toc">
        <ul>
            {% for item in items %}
                <li><a href="#{{ item.anchor }}">{{ item.title }}</a></li>
            {% endfor %}
        </ul>
    </nav>
    {% endif %}
{% endmacro %}
