{% extends 'base.jinja' %}
{% from 'tabular_sections.jinja' import render_crosstab, render_divider, render_group, render_image, render_kpi, render_summary, render_text, render_toc %}
{% block title %}{{meta.title}}{% endblock %}
{% block mode %}{{meta.mode}}{% endblock %}
{% block subtitle %}{{meta.sub_title}}{% endblock %}
{% block printed_at %}{{meta.printed_at}}{% endblock %}
{% block content %}
    {% for section in dataset.sections %}
        {% if section.title %}<h2 class="section-title"{% if section.anchor %} id="{{ section.anchor }}"{% endif %}>{{section.title}}</h2>{% endif %}
        {% if section.type == "table" %}
            {% if meta.summary_side == "top" and section.dataset.summary and section.layout.summary %}
                {{render_summary(section.dataset.summary, section.layout.summary, zip, fmt, cellstyle)}}
            {% endif %}
            {% if section.dataset.groups and section.layout.groups %}
                {{render_group(section.dataset.groups, section.layout.groups, zip, fmt, 0, cellstyle)}}
            {% elif section.empty_text %}
                <p class="empty-table">{{section.empty_text}}</p>
            {% endif %}
            {% if meta.summary_side != "top" and section.dataset.summary and section.layout.summary %}
                {{render_summary(section.dataset.summary, section.layout.summary, zip, fmt, cellstyle)}}
            {% endif %}
        {% elif section.type == "crosstab" %}
            {{render_crosstab(section.crosstab, zip, fmt, cellstyle)}}
        {% elif section.type == "text" %}
            {{render_text(section.paragraphs)}}
        {% elif section.type == "kpi" %}
            {{render_kpi(section['items'], fmt)}}
        {% elif section.type == "chart" %}
            <div class="chart">{{section.svg}}</div>
        {% elif section.type == "image" %}
            {{render_image(section.src, section.alt, section.width, section.align, section.caption)}}
        {% elif section.type == "toc" %}
            {{render_toc(section['items'])}}
        {% endif %}
        {% if section.footnotes %}
            <ol class="footnotes">
                {% for mark, text in section.footnotes %}
                    <li><sup>{{mark}}</sup> {{text}}</li>
                {% endfor %}
            </ol>
        {% endif %}
        {% if section.source %}
            <p class="source-note">{{section.source}}</p>
        {% endif %}
        {% if not loop.last %}{{render_divider()}}{% endif %}
    {% endfor %}
{% endblock %}
