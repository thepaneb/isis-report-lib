{% extends 'base.jinja' %}
{% from 'tabular_sections.jinja' import render_detail, render_details, render_group, render_divider, render_summary %}
{% block title %}{{meta.title}}{% endblock %}
{% block mode %}{{meta.mode}}{% endblock %}
{% block subtitle %}{{meta.sub_title}}{% endblock %}
{% block content %}
    {% if dataset.groups and layout.groups %}
        {{render_group(dataset.groups, layout.groups, zip, fmt, 0, cellstyle)}}
    {% elif meta.empty_text %}
        <p class="empty-report">{{meta.empty_text}}</p>
    {% endif %}
    {% if dataset.summary and layout.summary %}
        {{render_summary(dataset.summary, layout.summary, zip, fmt, cellstyle)}}
    {% endif %}
    {% if layout.footnotes %}
        <ol class="footnotes">
            {% for mark, text in layout.footnotes %}
                <li><sup>{{mark}}</sup> {{text}}</li>
            {% endfor %}
        </ol>
    {% endif %}
    {% if meta.source_note %}
        <p class="source-note">{{meta.source_note}}</p>
    {% endif %}
{% endblock %}
